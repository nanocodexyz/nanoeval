{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "types": ["node"],
    "lib": ["ES2023", "DOM", "DOM.Iterable", "ESNext.Disposable"],
    "skipLibCheck": true
  },
  "include": ["cli/*.ts", "sandbox/*.ts", "scripts/*.ts", "src/**/*.ts", "test/*.ts"]
}
