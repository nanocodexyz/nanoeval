{
  "name": "nanoeval",
  "version": "0.1.0",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "bin": {
    "nanoeval": "cli/nanoeval.ts"
  },
  "scripts": {
    "check": "vp check --fix",
    "check:types": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "dev": "wrangler dev",
    "dry-run": "wrangler deploy --dry-run --outdir output/deploy",
    "e2e": "node test/e2e.ts",
    "lint": "vp check",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "mppx": "0.16.0",
    "nanocode-ts": "https://github.com/nanocodexyz/nanocode-ts/releases/download/build-751e03a/nanocode-ts-751e03a.tgz",
    "smol-toml": "1.9.1",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261016.1",
    "@types/node": "22.20.5",
    "typescript": "6.0.2",
    "vite-plus": "0.2.4",
    "wrangler": "4.151.1"
  }
}
