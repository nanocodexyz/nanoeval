{
  "name": "nanoeval",
  "version": "0.1.0",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "bin": {
    "nanoeval": "cli/nanoeval.ts"
  },
  "scripts": {
    "check": "vp check --fix",
    "check:types": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "dev": "wrangler dev",
    "dry-run": "wrangler deploy --dry-run --outdir output/deploy",
    "e2e": "node test/e2e.ts",
    "lint": "vp check",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "hyparquet": "1.32.0",
    "mppx": "0.16.0",
    "nanocode-egress": "https://github.com/nanocodexyz/egress/releases/download/build-a0ff241/nanocode-egress-a0ff241.tgz",
    "nanocode-ts": "https://github.com/nanocodexyz/nanocode-ts/releases/download/build-7968b53/nanocode-ts-7968b53.tgz",
    "smol-toml": "1.9.1",
    "undici": "7.30.1",
    "viem": "2.57.7",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261016.1",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "6.0.2",
    "vite-plus": "0.2.4",
    "wrangler": "4.151.1"
  }
}
